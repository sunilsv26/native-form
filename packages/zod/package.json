    "test": "vitest run"
  },
  "dependencies": {
    "@native-form/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@native-form/adapter-contracts": "workspace:*"
  }
