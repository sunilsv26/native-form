{
  "name": "@native-form/react",
  "version": "0.1.3",
  "description": "React bindings, components, and hooks for Native Form.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunilsv26/native-form.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "forms",
    "useForm",
    "useField",
    "useWatch",
    "native-form"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react,react-dom,@native-form/core",
    "test": "vitest run"
  },
  "dependencies": {
    "@native-form/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4",
    "@native-form/adapter-contracts": "workspace:*",
    "zod": "^4.4.3",
    "@native-form/zod": "workspace:*",
    "yup": "^1.0.2",
    "@native-form/yup": "workspace:*",
    "valibot": "^1.5.0",
    "@native-form/valibot": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
