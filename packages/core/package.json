{
  "name": "@native-form/core",
  "version": "0.1.0",
  "description": "Framework-agnostic native HTML-first form runtime, discovery, and validation contracts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunilsv26/native-form.git",
    "directory": "packages/core"
  },
  "keywords": [
    "forms",
    "html5",
    "validation",
    "headless",
    "runtime",
    "zero-registration"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@native-form/adapter-contracts": "workspace:*"
  }
}
