{
  "name": "@native-form/valibot",
  "version": "0.1.4",
  "description": "Valibot schema validation adapter for Native Form.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunilsv26/native-form.git",
    "directory": "packages/valibot"
  },
  "keywords": [
    "valibot",
    "validation",
    "schema",
    "native-form"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external valibot,@native-form/core",
    "test": "vitest run"
  },
  "dependencies": {
    "@native-form/core": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@native-form/adapter-contracts": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
